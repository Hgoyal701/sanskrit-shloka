// api/interpret.js
// Vercel serverless handler: POST { shloka: "..." } -> interprets using OpenAI and returns JSON
export default async function handler(req, res) {
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'POST');
    return res.status(405).json({ error: 'Method not allowed. Use POST.' });
  }

  try {
    const { shloka } = req.body || {};
    const text = (shloka || '').toString().trim();
    if (!text) return res.status(400).json({ error: 'Please provide a shloka in the request body.' });

    const OPENAI_KEY = process.env.OPENAI_API_KEY;
    if (!OPENAI_KEY) return res.status(500).json({ error: 'OpenAI API key not configured on the server.' });

    const systemPrompt = `You are an expert Sanskrit scholar and classical commentator. When given a Sanskrit shloka, respond ONLY with a JSON object (no extra commentary) with these keys: translation, notes, inner_meaning, takeaway.
- translation: short literal translation in English.
- notes: brief context (origin, author, meter or brief textual notes) if known, otherwise an empty string.
- inner_meaning: the deeper philosophical/spiritual meaning.
- takeaway: a short practical takeaway.`;

    const userPrompt = `Interpret the following shloka and return the JSON described above.\n\nShloka:\n${text}`;

    const payload = {
      model: 'gpt-3.5-turbo',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userPrompt }
      ],
      temperature: 0.2,
      max_tokens: 800
    };

    const openaiRes = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${OPENAI_KEY}`
      },
      body: JSON.stringify(payload)
    });

    if (!openaiRes.ok) {
      const errText = await openaiRes.text();
      console.error('OpenAI error:', openaiRes.status, errText);
      return res.status(openaiRes.status).json({ error: 'OpenAI API request failed', detail: errText });
    }

    const completion = await openaiRes.json();
    const content = completion?.choices?.[0]?.message?.content ?? '';

    // Try to extract JSON substring (handles extra text or code fences)
    let parsed = null;
    try {
      const start = content.indexOf('{');
      const end = content.lastIndexOf('}');
      if (start !== -1 && end !== -1) {
        const candidate = content.slice(start, end + 1);
        parsed = JSON.parse(candidate);
      }
    } catch (e) {
      parsed = null;
    }

    if (parsed && typeof parsed === 'object') {
      return res.status(200).json({ result: parsed, raw: content });
    }

    // Fallback: return raw text if JSON parsing failed
    return res.status(200).json({ text: content });
  } catch (err) {
    console.error('Handler exception:', err);
    return res.status(500).json({ error: 'Internal server error' });
  }
}
