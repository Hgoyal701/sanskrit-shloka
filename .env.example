# .env.example
# Copy this to .env.local (for local dev) or set these keys in Vercel Project → Settings → Environment Variables.
# NEVER commit your real API key.

# Your OpenAI API key (secret). Example: sk-...
OPENAI_API_KEY=

# Model to use. Change if you want a different model.
# Examples: gpt-4o-mini, gpt-4, gpt-3.5-turbo
MODEL=gpt-3.5-turbo

# Optional: maximum tokens for the response (server will default if missing)
MAX_TOKENS=700

# Optional: temperature (0.0-1.0). Lower -> more deterministic
TEMPERATURE=0.25
